+# =============================================================================
+# src/bca.py
+# BCa bootstrap confidence interval for the MAE, step by step as in the
+# protocol "BCa Bootstrap Confidence Intervals for the Mean Absolute Error of
+# Predicted Vehicle Acceleration" (Efron & Tibshirani, 1993, Ch. 6, 11, 13, 14).
+#
+#   Step 1  e_i = |ŷ_i − y_i|
+#   Step 2  θ̂ = mean(e)                                    observed MAE
+#   Step 3  B resamples of the n rows with replacement     → θ̂*(b)
+#   Step 4  ẑ0 = Φ⁻¹( #{θ̂*(b) < θ̂} / B )                 bias correction
+#   Step 5  jackknife θ̂(i) = (Σe − e_i)/(n − 1), θ̂(·) = mean
+#   Step 6  â = Σ(θ̂(·) − θ̂(i))³ / (6 [Σ(θ̂(·) − θ̂(i))²]^(3/2))
+#   Step 7  α1, α2 = Φ(ẑ0 + (ẑ0 + z)/(1 − â(ẑ0 + z))), z = z^(α), z^(1−α)
+#   Step 8  CI = percentiles α1, α2 of the sorted θ̂*, linear interpolation
+#           at position p·(B − 1)
+# =============================================================================
+
+import numpy as np
+from scipy.stats import norm
+
+
+def resample_indices(n: int, B: int, rng: np.random.Generator) -> np.ndarray:
+    """Step 3.1: B × n row numbers drawn at random with replacement."""
+    return rng.integers(0, n, size=(B, n))
+
+
+def bias_correction(boot: np.ndarray, theta_hat: float) -> float:
+    """Step 4. A proportion of exactly 0 or 1 is kept inside (0, 1)."""
+    B = len(boot)
+    prop = float(np.sum(boot < theta_hat)) / B
+    prop = min(max(prop, 0.5 / B), 1.0 - 0.5 / B)
+    return float(norm.ppf(prop))
+
+
+def acceleration(e: np.ndarray) -> float:
+    """Steps 5–6: jackknife (leave-one-out) MAEs and the acceleration constant."""
+    n = len(e)
+    theta_i = (e.sum() - e) / (n - 1)
+    d = theta_i.mean() - theta_i
+    den = 6.0 * float(np.sum(d ** 2)) ** 1.5
+    return float(np.sum(d ** 3) / den) if den > 0 else 0.0
+
+
+def adjusted_levels(z0: float, a: float, alpha: float) -> tuple:
+    """Step 7."""
+    z_lo, z_hi = norm.ppf(alpha), norm.ppf(1.0 - alpha)
+    a1 = norm.cdf(z0 + (z0 + z_lo) / (1.0 - a * (z0 + z_lo)))
+    a2 = norm.cdf(z0 + (z0 + z_hi) / (1.0 - a * (z0 + z_hi)))
+    return float(a1), float(a2)
+
+
+def bca_mae(y_true, y_pred, idx: np.ndarray, alpha: float) -> dict:
+    """Full protocol for one model on one vehicle. idx: (B, n) resampled rows."""
+    e = np.abs(np.asarray(y_pred, float) - np.asarray(y_true, float))   # Step 1
+    theta_hat = float(e.mean())                                          # Step 2
+    boot = e[idx].mean(axis=1)                                           # Step 3
+    z0 = bias_correction(boot, theta_hat)                                # Step 4
+    a_hat = acceleration(e)                                              # Steps 5–6
+    a1, a2 = adjusted_levels(z0, a_hat, alpha)                           # Step 7
+    lo, hi = np.quantile(boot, [a1, a2], method="linear")                # Step 8
+    return {
+        "mae": theta_hat,
+        "boot_mean": float(boot.mean()),
+        "boot_sd": float(boot.std(ddof=1)),
+        "z0": z0, "a": a_hat, "alpha1": a1, "alpha2": a2,
+        "ci_low": float(lo), "ci_high": float(hi),
+        "boot": boot,
+    }
