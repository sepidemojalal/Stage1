+# ─────────────────────────────────────────────────────────────────────────────
+# Training fit
+# ─────────────────────────────────────────────────────────────────────────────
+def train_fit(model: torch.nn.Module, dataset: AccelerationDataset) -> tuple:
+    """MAE and MSE of a trained model on the blocks it was trained on."""
+    y_hat = predict(model, dataset).astype(float)
+    y     = dataset.y.numpy().astype(float)
+    err   = y_hat - y
+    return float(np.mean(np.abs(err))), float(np.mean(err ** 2))
+
+
